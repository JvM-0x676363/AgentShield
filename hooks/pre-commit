#!/usr/bin/env sh
# AgentShield pre-commit hook. It audits only; server-side CI is the blocking gate.

if [ "${SKIP_SECURITY_HOOK:-0}" = "1" ]; then
  exit 0
fi

HOOK_DIR=$(CDPATH= cd "$(dirname "$0")" && pwd)
STATE_DIR="${SECURITY_HOOK_STATE_DIR:-$HOME/.git-hooks}"
RUNNER="$HOOK_DIR/agent-shield-scan.py"
RULES_DIR="$HOOK_DIR/agent-shield-rules"

run_scan() {
  "$@" "$RUNNER" --staged --rules-dir "$RULES_DIR" \
    --state-path "$STATE_DIR/last-scan.json" --output-mode Console
}

if [ ! -f "$RUNNER" ]; then
  echo "[AGENTSHIELD SCAN] result: environment_blocked (runner_not_found)"
  exit 0
fi

if command -v python3 >/dev/null 2>&1; then
  run_scan python3 || true
elif command -v python >/dev/null 2>&1; then
  run_scan python || true
elif command -v py >/dev/null 2>&1; then
  py -3 "$RUNNER" --staged --rules-dir "$RULES_DIR" \
    --state-path "$STATE_DIR/last-scan.json" --output-mode Console || true
else
  echo "[AGENTSHIELD SCAN] result: environment_blocked (python3_not_found)"
fi

exit 0
